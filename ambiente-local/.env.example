# bootstrap.py generates local secrets if .env does not exist.
MOODLE_DB_PASSWORD=
MOODLE_ADMIN_PASSWORD=
ADAPTIA_DB_PASSWORD=
ADAPTIA_SERVICE_TOKEN=
ADAPTIA_ACTOR_SECRET=
ADAPTIA_TEST_DB_PASSWORD=
# Opcional: vacío utiliza la extensión real en el contenedor local `down`.
ADAPTIA_DOWN_URL=
# Credencial del proveedor remoto. Permanece en el servidor; el navegador no la recibe.
ADAPTIA_DOWN_TOKEN=
# Checkout de Misión Down. Ruta relativa a ambiente-local o ruta absoluta.
# Vacío utiliza ../../andres-morocho/mision_down-dashboard (versión QA).
MISION_DOWN_SOURCE=
# Conexión opcional a TutorIA real. Separada del token entre Moodle y esta pasarela.
# Al usar compose.tutoria.yaml: http://tutoria-api:8000
ADAPTIA_TUTORIA_URL=
ADAPTIA_TUTORIA_TOKEN=
ADAPTIA_TUTORIA_TIMEOUT=70
